[Unit]
Description=Dedicated MediaMTX endpoint for YOLO annotated camera output
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/kame-yolo
ExecStart=/opt/kame-camera/mediamtx /opt/kame-yolo/mediamtx.yml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
